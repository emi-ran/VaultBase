# SQLite database connection URL (local settings storage)
DATABASE_URL="file:./dev.db"

# VaultBase secret key used for encrypting database passwords
# Replace with a strong, random secret key in production (e.g., openssl rand -base64 32)
APP_SECRET="replace-with-a-secure-random-secret-key-for-password-encryption"

# Port to run the application server (defaults to 3000)
PORT=3000
