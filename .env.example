# SQLite database connection URL (local settings storage)
DATABASE_URL="file:./dev.db"

# VaultBase secret key used for encrypting database passwords and session tokens
# Replace with a strong, random secret key in production (e.g., openssl rand -base64 32)
APP_SECRET="replace-with-a-secure-random-secret-key-for-password-encryption"

# Admin login credentials (used for web interface authentication)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Port to run the application server (defaults to 3000)
PORT=3000

# Backup directory path (optional, defaults to ./backups)
BACKUP_DIR="./backups"

# Maximum storage limit in megabytes (optional, defaults to 5120 MB / 5 GB)
STORAGE_LIMIT_MB=5120
